# No secrets here. Generate secrets/ separately with deploy.init_secrets.
ADMIN_USERNAME=admin
PUBLIC_BASE_URL=http://127.0.0.1:8001
SITE_DOMAIN=
SESSION_MAX_AGE_SECONDS=43200
YOUTUBE_DOH_ENABLED=true
YOUTUBE_DOH_TEMPLATE=https://dns.google/dns-query
YOUTUBE_STUDIO_TIMEOUT_SECONDS=90
YOUTUBE_UPLOAD_TIMEOUT_SECONDS=600
TIKTOK_WEB_HEADLESS=false
TIKTOK_WEB_TIMEOUT_SECONDS=600
Y2SAVE_TIMEOUT_SECONDS=600
DOWNLOAD_PROVIDER_ORDER=direct,cnvmp3,y2save
DOWNLOAD_PROVIDER_TIMEOUT_SECONDS=120
DOWNLOAD_FAILURE_COOLDOWN_SECONDS=60
CNVMP3_URL=https://cnvmp3.com/
Y2SAVE_HEADLESS=false
Y2SAVE_DOH_ENABLED=true
Y2SAVE_DOH_TEMPLATE=https://dns.google/dns-query
MAX_UPLOAD_BYTES=536870912
WORKER_STALE_AFTER_SECONDS=3600
QA_ALLOWED_DOMAINS=example.com,localhost,127.0.0.1
ACCOUNT_VIEWS_ENABLED=true
